    "camel-knowledge": {
      "command": "jbang",
      "args": [
        "--repos", "central=https://repo1.maven.org/maven2/,central_snap=https://central.sonatype.com/repository/maven-snapshots/",
        "-Dquarkus.log.level=WARN",
        "io.github.luigidemasi:camel-kit-knowledge-mcp:0.0.2:runner"
      ],
      "description": "camel-kit Knowledge Server - documentation search for Apache Camel",
      "autoApprove": ["camel_docs_component_info","camel_docs_search","camel_docs_cve_search","camel_docs_release_info","camel_docs_jira_lookup"],
      "alwaysAllow": ["camel_docs_component_info","camel_docs_search","camel_docs_cve_search","camel_docs_release_info","camel_docs_jira_lookup"]
